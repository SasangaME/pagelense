# Local development settings

# Public app server
PORT=8080
# /metrics and /debug/pprof; must differ from PORT
ADMIN_PORT=9090
# debug, info, warn or error
LOG_LEVEL=debug

# Whole page fetch, including redirects and reading the body
FETCH_TIMEOUT=10s
# Per checked link
LINK_TIMEOUT=5s
# All link checks of one analysis; links not finished in time are not counted as checked
LINK_BUDGET=10s
# How long in-flight requests get to finish on Ctrl+C or SIGTERM
SHUTDOWN_TIMEOUT=15s

# Concurrent link checks per analysis
LINK_WORKERS=10
# Unique links checked per analysis
MAX_LINKS=100

# Frontend only: backend base URL
API_URL=http://localhost:8081
# Frontend only: whole backend call; must outlast FETCH_TIMEOUT + LINK_BUDGET
API_TIMEOUT=30s
